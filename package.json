{
  "name": "weekend-planner",
  "version": "1.0.0",
  "description": "两个人的周末活动推荐 App：DeepSeek + GPT 联网搜索本周末活动，结合你们的偏好每周定时推送到 iPhone，可投票、留言，AI 会记住你们的选择。运行在 Cloudflare Workers + D1 上，免费部署。",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinjian28/weekend-planner.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --no-warnings test/run.mjs",
    "deploy": "wrangler deploy",
    "dev": "node build.mjs && wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  },
  "engines": {
    "node": ">=22"
  },
  "cloudflare": {
    "label": "周末去哪儿 · Weekend Planner",
    "products": ["Workers", "D1"],
    "categories": ["storage"],
    "bindings": {
      "DB": {
        "description": "存放清单、投票、留言、AI 记忆和设置的 D1 数据库。会自动创建，**保持默认即可**。"
      }
    }
  }
}
